{
  "name": "fedsa",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contract",
    "apps/api",
    "apps/jobs",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:contract": "npm run test:contract --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi": "npm run build -w packages/contract && node scripts/openapi.mjs",
    "openapi:check": "npm run build -w packages/contract && node scripts/openapi.mjs --check",
    "budget": "npm run build -w packages/contract && npm run budget -w apps/web",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run budget"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
