# copy to .env for local development. deployed values live in the hosting platforms

# MongoDB connection string
MONGODB_URI=

# signs the session cookie. a long random string, different in every environment
SESSION_SECRET=

# set to development locally, so the session cookie works over plain http. leave empty when deployed
NODE_ENV=

# port the API listens on. defaults to 3000
PORT=

# how far from a donor, in kilometres, a recipient can be and still see its offers. defaults to 15
MATCH_RADIUS_KM=

# set to false where a cron service runs the expiry and retention sweeps. on when empty
API_SWEEPS=

# set by Render on each deploy and reported by /api/health. leave empty locally
RENDER_GIT_COMMIT=

# channels to send through besides the in-app inbox, comma separated: push, whatsapp, sms, console.
# console logs SMS text instead of sending it. a listed channel with a missing setting stays off
NOTIFY_CHANNELS=

# set to false to stop mirroring offer notifications to WhatsApp or SMS. on when empty
NOTIFY_MIRROR=

# web push key pair, a separate pair in every environment. the subject is a mailto: or https: address
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# where photos are kept: local (the default) or cloudinary. cloudinary needs CLOUDINARY_URL
PHOTO_STORE=
# cloudinary://KEY:SECRET@CLOUD_NAME from the Cloudinary console
CLOUDINARY_URL=
# folder for uploads, for example fedsa/staging. defaults to fedsa
CLOUDINARY_FOLDER=

# Twilio account for SMS and WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# sending numbers in E.164 form, for example a Twilio trial number
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# the https origin Twilio calls the API on, with no trailing slash. Twilio signs its webhook requests
# against it and reports delivery to it. without it the webhooks refuse every request
PUBLIC_API_URL=

# password for every seeded demo account, 10 to 72 characters. only `npm run seed` reads it
SEED_PASSWORD=

# the database host the seed may write to for --env=staging or --env=demo, as its refusal prints it.
# set it on the command line for one run rather than here
SEED_CONFIRM_HOST=
